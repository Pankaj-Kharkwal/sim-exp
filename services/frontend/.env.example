# Pankh.AI Frontend Configuration
# Copy this file to .env and fill in your values

# ====================================
# API Configuration
# ====================================
# Backend API URL
VITE_API_URL=http://localhost:8000/api/v1

# WebSocket URL for real-time features
VITE_WS_URL=http://localhost:8000

# ====================================
# Authentication
# ====================================
# JWT token storage key
VITE_AUTH_TOKEN_KEY=pankh_auth_token

# Session timeout (milliseconds)
VITE_SESSION_TIMEOUT=604800000 # 7 days

# ====================================
# Application Configuration
# ====================================
# App name and branding
VITE_APP_NAME=Pankh.AI
VITE_APP_DESCRIPTION=AI-powered workflow orchestration platform

# Environment
VITE_ENVIRONMENT=development # development, production, staging

# ====================================
# Feature Flags
# ====================================
# Enable/disable features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_TELEMETRY=false
VITE_ENABLE_COPILOT=true
VITE_ENABLE_COLLABORATION=true

# ====================================
# Analytics & Monitoring
# ====================================
# PostHog (optional)
VITE_POSTHOG_KEY=...
VITE_POSTHOG_HOST=https://app.posthog.com

# Sentry (optional)
VITE_SENTRY_DSN=...

# ====================================
# External Services
# ====================================
# Stripe (for billing, optional)
VITE_STRIPE_PUBLISHABLE_KEY=pk_...

# ====================================
# UI Configuration
# ====================================
# Default theme
VITE_DEFAULT_THEME=system # light, dark, system

# Max file upload size (bytes)
VITE_MAX_FILE_UPLOAD_SIZE=52428800 # 50MB

# Pagination defaults
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# ====================================
# Development Configuration
# ====================================
# Enable debug mode
VITE_DEBUG=true

# Mock external services
VITE_MOCK_SERVICES=false

# ====================================
# API Timeouts
# ====================================
# Request timeout (milliseconds)
VITE_API_TIMEOUT=30000 # 30 seconds

# Upload timeout (milliseconds)
VITE_UPLOAD_TIMEOUT=120000 # 2 minutes
