# Pankh.AI Backend Environment Variables

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Pankh.AI Backend
VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pankhai
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=pankh:

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# AI Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
GROQ_API_KEY=your-groq-api-key

# Storage
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_STORAGE_CONTAINER=workflows
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=pankh-ai-workflows
AWS_REGION=us-east-1

# Email
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@pankh.ai

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Azure Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string

# Feature Flags
ENABLE_BLOCK_GENERATION=true
ENABLE_COPILOT=true
ENABLE_TELEMETRY=true

# Execution
MAX_EXECUTION_TIME=600
MAX_PARALLEL_EXECUTIONS=10
